# Device object storage (dev_oss_sts_info_new_v2) backed by the bundled Garage S3.
LOCALKIT_STORAGE_ENABLE=true
# Base URL the camera uses to reach the OCI emulation (LAN address of this host).
LOCALKIT_STORAGE_ENDPOINT=http://127.0.0.1
LOCALKIT_S3_ENDPOINT=http://localkit-storage:3900
LOCALKIT_S3_REGION=garage
LOCALKIT_S3_BUCKET=localkit
LOCALKIT_S3_KEY=GKe1fd06e4975f7148c6f4359fa9d50163
LOCALKIT_S3_SECRET=b2ebda94643d392065f5381599e6db2a1a87367786742dfce9aac56e4904d9ab

VITE_APP_NAME="${APP_NAME}"

BYPASS_AUTH=false
BYPASS_AUTH_ID=1

# NextGen device telnet reboot fallback (DeviceActions "Reboot (Telnet)") -
# root credentials for the device's own telnetd. Leave unset to disable the
# button; never commit real values here.
DEVICE_TELNET_USERNAME=
DEVICE_TELNET_PASSWORD=
